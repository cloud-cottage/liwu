{
  "name": "liwu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:app": "npm --workspace @liwu/app run dev",
    "dev:web": "npm --workspace @liwu/web run dev",
    "build": "node scripts/build-deploy.mjs",
    "build:app": "npm --workspace @liwu/app run build",
    "build:web": "npm --workspace @liwu/web run build",
    "assets:sync": "node packages/shared-assets/scripts/sync-miniprogram.mjs",
    "packages:sync": "node scripts/sync-miniprogram-packages.mjs",
    "miniprogram:sync": "npm run assets:sync && npm run packages:sync",
    "build:miniprogram": "npm run miniprogram:sync && npm --workspace @liwu/miniprogram run build",
    "build:server": "npm --workspace @liwu/server run build",
    "audio:transcode-worker": "node scripts/audio-transcode-worker.mjs",
    "audio:transcode-worker:loop": "node scripts/audio-transcode-worker.mjs --loop",
    "lint": "eslint .",
    "preview": "npm --workspace @liwu/web run preview"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^2.25.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
