.meditation-page-shell {
  padding-bottom: 44rpx;
}

.meditation-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(143, 165, 138, 0.12);
  color: #8b5e34;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.meditation-hero-card {
  min-height: 660rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background:
    radial-gradient(circle at top right, rgba(143, 165, 138, 0.18), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 245, 239, 0.94) 100%);
}

.meditation-kicker {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #111827;
}

.meditation-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
  max-width: 88%;
}

.meditation-console {
  margin-top: 28rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meditation-disc {
  width: 248rpx;
  height: 248rpx;
  border-radius: 999rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meditation-disc-ring {
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
  border: 2rpx solid rgba(143, 165, 138, 0.16);
  box-shadow:
    inset 0 0 0 16rpx rgba(255, 255, 255, 0.58),
    0 24rpx 48rpx rgba(143, 165, 138, 0.14);
}

.meditation-orb {
  width: 148rpx;
  height: 148rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8fa58a, #a7b69a);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  box-shadow: 0 22rpx 44rpx rgba(143, 165, 138, 0.24);
}

.meditation-timer {
  margin-top: 28rpx;
  font-size: 92rpx;
  line-height: 1;
  font-weight: 700;
  color: #1f2937;
}

.meditation-button {
  width: 100%;
  margin-top: 32rpx;
}

.meditation-timer-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
}

/* 错误态（五类错误码各自文案 ＋ requestId ＋ 重试）：可见、不静默、不回退老音频库 */
.meditation-error-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(180, 83, 9, 0.24);
  background: rgba(254, 243, 199, 0.72);
  text-align: left;
}

.meditation-error-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #92400e;
}

.meditation-error-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7c2d12;
}

.meditation-error-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #92400e;
  opacity: 0.86;
}

.meditation-notice {
  width: 100%;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(107, 114, 128, 0.22);
  background: rgba(243, 244, 246, 0.8);
  text-align: left;
}

.meditation-notice-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #4b5563;
}

.meditation-retry-button {
  margin-top: 14rpx;
  width: 100%;
}

/* 段级 warning（逐字文案 ＋ 汇总计数）：跳段可见、其余段照常、整场不失败 */
.meditation-warning-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(143, 165, 138, 0.28);
  background: rgba(240, 247, 236, 0.82);
  text-align: left;
}

.meditation-warning-summary {
  font-size: 24rpx;
  font-weight: 700;
  color: #3f6212;
}

.meditation-warning-line {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #4d7c0f;
}

.meditation-actions {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.meditation-action-button {
  width: 100%;
}

.meditation-stats-card {
  margin-top: 24rpx;
  text-align: center;
}

.meditation-stats-line {
  font-size: 24rpx;
  color: #6b7280;
  opacity: 0.78;
}
