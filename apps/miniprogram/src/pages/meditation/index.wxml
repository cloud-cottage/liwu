<view class="page-shell meditation-page-shell">
  <view class="page-masthead">
    <view class="page-masthead__pill">Meditation</view>
    <view class="page-masthead__title">静寂</view>
    <view class="page-masthead__slogan">{{meditationSlogan}}</view>
  </view>

  <view class="section-card meditation-hero-card">
    <view class="meditation-kicker">当下即是献礼</view>
    <view class="meditation-subtitle">给自己 15 分钟的留白。在呼吸间寻回内在的秩序。</view>

    <view class="meditation-console">
      <view class="meditation-disc">
        <view class="meditation-disc-ring"></view>
        <view class="meditation-orb">静</view>
      </view>
      <view class="meditation-timer">{{timeLabel}}</view>
      <view class="meditation-timer-hint" wx:if="{{loading}}">正在读取冥想轨道…</view>
    </view>

    <view class="meditation-error-card" wx:if="{{errorMessage}}">
      <view class="meditation-error-title">冥想内容加载失败</view>
      <view class="meditation-error-text">{{errorMessage}}</view>
      <view class="meditation-error-meta" wx:if="{{errorCode}}">错误码：{{errorCode}}</view>
      <view class="meditation-error-meta" wx:if="{{errorRequestId}}">requestId：{{errorRequestId}}</view>
      <button class="ghost-button meditation-retry-button" bindtap="handleRetryLoad">重试</button>
    </view>

    <view class="meditation-notice" wx:elif="{{emptyPlanNotice}}">
      <view class="meditation-notice-text">{{emptyPlanNotice}}</view>
      <button class="ghost-button meditation-retry-button" bindtap="handleRetryLoad">重试</button>
    </view>

    <view class="meditation-warning-card" wx:if="{{segmentWarningCount > 0}}">
      <view class="meditation-warning-summary">{{segmentWarningSummary}}</view>
      <view class="meditation-warning-line" wx:for="{{segmentWarnings}}" wx:key="*this">{{item}}</view>
    </view>

    <button
      class="primary-button meditation-button"
      loading="{{saving}}"
      disabled="{{saving || loading || !audioReady}}"
      bindtap="handleToggleMeditation"
    >
      {{running ? '暂停静寂' : '冥想此刻'}}
    </button>

    <view class="meditation-actions">
      <button class="ghost-button meditation-action-button" bindtap="handleResetMeditation">重新开始</button>
      <button class="ghost-button meditation-action-button" open-type="share">分享静寂</button>
    </view>
  </view>

  <view class="meditation-stats-card">
    <view class="meditation-stats-line">往日 {{stats.pastCount}} → 今日 {{stats.todayCount}} → 来日 ∞</view>
  </view>
</view>
