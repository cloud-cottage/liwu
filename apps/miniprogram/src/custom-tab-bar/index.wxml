<view class="tabbar-shell">
  <view class="tabbar-panel">
    <view
      class="tabbar-item {{selectedPath === item.pagePath ? 'tabbar-item-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-path="{{item.pagePath}}"
      bindtap="handleTabTap"
    >
      <view class="tabbar-indicator"></view>
      <view class="tabbar-icon-slot">
        <view
          class="tabbar-icon-mask {{item.iconClass}}"
          style="mask-image: url('{{selectedPath === item.pagePath ? item.activeIcon : item.icon}}'); -webkit-mask-image: url('{{selectedPath === item.pagePath ? item.activeIcon : item.icon}}');"
        />
      </view>
      <view class="tabbar-label">{{item.text}}</view>
    </view>
  </view>
</view>