{
  "collections": [
    {
      "name": "users",
      "purpose": "Core identity and login binding only",
      "fields": [
        "_openid",
        "uid",
        "auth_uid",
        "phone",
        "email",
        "status",
        "created_at",
        "updated_at",
        "join_date",
        "last_active"
      ]
    },
    {
      "name": "user_profiles",
      "purpose": "Display profile and editable bio/avatar information",
      "fields": [
        "_openid",
        "user_id",
        "name",
        "note_name",
        "avatar",
        "avatar_index",
        "bio",
        "location",
        "age",
        "name_updated_at",
        "created_at",
        "updated_at"
      ]
    },
    {
      "name": "user_wallets",
      "purpose": "Wallet snapshot and reward idempotency state",
      "fields": [
        "_openid",
        "user_id",
        "balance",
        "reward_claims",
        "created_at",
        "updated_at"
      ]
    },
    {
      "name": "user_memberships",
      "purpose": "Student membership entitlement state",
      "fields": [
        "_openid",
        "user_id",
        "is_student",
        "student_expire_at",
        "student_membership_plan_key",
        "created_at",
        "updated_at"
      ]
    },
    {
      "name": "user_referrals",
      "purpose": "Referral edge from inviter to current user",
      "fields": [
        "_openid",
        "user_id",
        "inviter_user_id",
        "source",
        "created_at",
        "updated_at"
      ]
    },
    {
      "name": "user_partner_identities",
      "purpose": "Store and partner-facing identity projection",
      "fields": [
        "_openid",
        "user_id",
        "store_id",
        "store_name",
        "store_role",
        "store_owner_user_id",
        "store_description",
        "store_contact",
        "created_at",
        "updated_at"
      ]
    },
    {
      "name": "user_operational_states",
      "purpose": "Per-user daily burn and operational state",
      "fields": [
        "_openid",
        "user_id",
        "beans_daily_settled_at",
        "beans_last_extinguished_at",
        "beans_last_ignited_at",
        "created_at",
        "updated_at"
      ]
    }
  ]
}
